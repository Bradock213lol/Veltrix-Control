<Window x:Class="VeltrixControl.Desktop.FileEditorWindow" Style="{StaticResource {x:Type Window}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Edit file" Width="1040" Height="740" MinWidth="720" MinHeight="520"
        WindowStartupLocation="CenterOwner" Loaded="Window_Loaded" Closing="Window_Closing">
  <Grid Margin="18">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="Auto"/>
      <RowDefinition Height="*"/>
      <RowDefinition Height="Auto"/>
    </Grid.RowDefinitions>

    <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
      <Grid>
        <StackPanel Orientation="Horizontal">
          <Button Content="Save" Style="{StaticResource PrimaryButton}" Click="Save_Click" Margin="0,0,8,0"/>
          <Button Content="Reload" Click="Reload_Click" Margin="0,0,8,0"/>
          <Button Content="Find / Replace" Click="ToggleFind_Click" Margin="0,0,8,0"/>
          <Button Content="History" Click="ToggleHistory_Click"/>
        </StackPanel>
        <TextBlock x:Name="DirtyIndicator" HorizontalAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource WarningBrush}"/>
      </Grid>
    </Border>

    <Border x:Name="FindPanel" Grid.Row="1" Style="{StaticResource PanelBorder}" Visibility="Collapsed" Margin="0,0,0,10">
      <Grid>
        <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
        </Grid.ColumnDefinitions>
        <TextBox x:Name="FindBox" AutomationProperties.Name="Find text"/>
        <TextBox x:Name="ReplaceBox" Grid.Column="1" Margin="8,0,8,0" AutomationProperties.Name="Replace text"/>
        <Button Grid.Column="2" Content="Find next" Click="FindNext_Click" Margin="0,0,8,0"/>
        <Button Grid.Column="3" Content="Replace all" Click="ReplaceAll_Click" Margin="0,0,8,0"/>
        <Button Grid.Column="4" Content="Close" Click="ToggleFind_Click"/>
      </Grid>
    </Border>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
      </Grid.ColumnDefinitions>
      <Border Style="{StaticResource PanelBorder}" Padding="0">
        <Grid>
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto"/>
            <ColumnDefinition Width="*"/>
          </Grid.ColumnDefinitions>
          <TextBox x:Name="LineNumbers" Width="56" IsReadOnly="True" Focusable="False" BorderThickness="0"
                   Background="{DynamicResource SurfaceMutedBrush}" Foreground="{DynamicResource MutedTextBrush}"
                   FontFamily="Consolas" FontSize="13" TextAlignment="Right" Padding="6,8,8,8"
                   VerticalScrollBarVisibility="Hidden" HorizontalScrollBarVisibility="Hidden"/>
          <TextBox x:Name="EditorBox" Grid.Column="1" AcceptsReturn="True" AcceptsTab="True"
                   FontFamily="Consolas" FontSize="13" Padding="8" BorderThickness="0"
                   VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"
                   AutomationProperties.Name="File content"
                   TextChanged="EditorBox_TextChanged" ScrollViewer.ScrollChanged="EditorBox_ScrollChanged"/>
        </Grid>
      </Border>
      <Border x:Name="HistoryPanel" Grid.Column="1" Style="{StaticResource PanelBorder}" Width="320" Margin="10,0,0,0" Visibility="Collapsed">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel>
            <TextBlock Text="BACKUP HISTORY" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CyanBrush}"/>
            <TextBlock Text="A backup is captured before every save." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,10"/>
          </StackPanel>
          <ListBox x:Name="HistoryList" Grid.Row="1" DisplayMemberPath="Display"/>
          <Button Grid.Row="2" Content="Restore selected" Margin="0,10,0,0" Click="Restore_Click"/>
          <Button Grid.Row="3" Content="Compare with current" Margin="0,8,0,0" Click="Compare_Click"/>
        </Grid>
      </Border>
    </Grid>

    <Border Grid.Row="3" Margin="0,10,0,0">
      <TextBlock x:Name="StatusLine" Foreground="{DynamicResource MutedTextBrush}" TextTrimming="CharacterEllipsis"/>
    </Border>
  </Grid>
</Window>
