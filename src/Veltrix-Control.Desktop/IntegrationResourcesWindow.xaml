<Window x:Class="VeltrixControl.Desktop.IntegrationResourcesWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Integration resources" Width="960" Height="680" MinWidth="700" MinHeight="480"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="1.1*"/></Grid.RowDefinitions>
    <WrapPanel>
      <TextBlock x:Name="Caption" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button Content="Refresh" Margin="16,0,0,0" Click="Refresh_Click"/>
      <Button Content="Start" Margin="8,0,0,0" Click="Start_Click"/>
      <Button Content="Stop" Margin="8,0,0,0" Click="Stop_Click"/>
      <Button Content="Restart" Margin="8,0,0,0" Click="Restart_Click"/>
      <Button Content="Logs" Margin="8,0,0,0" Click="Logs_Click"/>
    </WrapPanel>
    <DataGrid x:Name="ResourcesGrid" Grid.Row="1" Margin="0,12,0,0">
      <DataGrid.Columns>
        <DataGridTextColumn Header="Resource" Binding="{Binding Name}" Width="2.5*"/>
        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
        <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="3*"/>
      </DataGrid.Columns>
    </DataGrid>
    <TextBlock Grid.Row="2" Text="LOGS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CyanBrush}" Margin="2,14,0,6"/>
    <TextBox x:Name="LogsBox" Grid.Row="3" IsReadOnly="True" FontFamily="Consolas" FontSize="12"
             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
  </Grid>
</Window>
