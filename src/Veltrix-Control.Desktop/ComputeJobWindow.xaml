<Window x:Class="VeltrixControl.Desktop.ComputeJobWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New compute job" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20">
    <TextBlock Text="Queue a compute job" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock x:Name="Subtitle" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,16"/>
    <Label Content="Job name"/>
    <TextBox x:Name="NameBox" MaxLength="128" Margin="0,0,0,12"/>
    <Label Content="Executable path on the node (.exe)"/>
    <TextBox x:Name="ExecutableBox" MaxLength="1024" Margin="0,0,0,12"/>
    <Label Content="Arguments (optional)"/>
    <TextBox x:Name="ArgumentsBox" MaxLength="2048" Margin="0,0,0,12"/>
    <Label Content="Working directory (optional)"/>
    <TextBox x:Name="WorkingDirectoryBox" MaxLength="1024" Margin="0,0,0,12"/>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><Label Content="CPU threads"/><TextBox x:Name="CpuBox" Text="1"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="10,0,0,0"><Label Content="Memory (MB)"/><TextBox x:Name="MemoryBox" Text="256"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="10,0,0,0"><Label Content="Disk (MB)"/><TextBox x:Name="DiskBox" Text="100"/></StackPanel>
      <StackPanel Grid.Column="3" Margin="10,0,0,0"><Label Content="Priority"/><TextBox x:Name="PriorityBox" Text="100"/></StackPanel>
    </Grid>
    <Grid Margin="0,12,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><Label Content="Timeout (seconds)"/><TextBox x:Name="TimeoutBox" Text="600"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="10,0,0,0"><Label Content="Max attempts"/><TextBox x:Name="AttemptsBox" Text="1"/></StackPanel>
    </Grid>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" MinHeight="22" Margin="0,12,0,8"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/>
      <Button Content="Queue job" Style="{StaticResource PrimaryButton}" Click="Create_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
