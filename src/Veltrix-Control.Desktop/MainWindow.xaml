<Window x:Class="VeltrixControl.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Veltrix-Control" Width="1380" Height="860" MinWidth="1040" MinHeight="680"
        WindowStartupLocation="CenterScreen" Loaded="Window_Loaded" KeyDown="Window_KeyDown">
  <Grid>
    <Grid x:Name="LoginGrid">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="500"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
      <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
      <Border Grid.Column="1" Grid.Row="1" Style="{StaticResource PanelBorder}" Padding="34">
        <StackPanel>
          <Border Width="54" Height="8" Background="{DynamicResource AccentBrush}" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,26"/>
          <TextBlock Text="VELTRIX-CONTROL" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource CyanBrush}"/>
          <TextBlock x:Name="AuthTitle" Text="Connect to your fleet" FontSize="30" FontWeight="SemiBold" Margin="0,8,0,8"/>
          <TextBlock x:Name="AuthSubtitle" Text="Sign in to the local Controller." Foreground="{DynamicResource MutedTextBrush}" Margin="0,0,0,24"/>
          <Label Content="Controller address" Target="{Binding ElementName=AuthControllerUrl}"/>
          <TextBox x:Name="AuthControllerUrl" AutomationProperties.Name="Controller address" Margin="0,0,0,14"/>
          <Label Content="Username" Target="{Binding ElementName=UsernameBox}"/>
          <TextBox x:Name="UsernameBox" AutomationProperties.Name="Username" MaxLength="64" Margin="0,0,0,14"/>
          <Label Content="Password" Target="{Binding ElementName=PasswordBox}"/>
          <PasswordBox x:Name="PasswordBox" AutomationProperties.Name="Password" MaxLength="256" Margin="0,0,0,8"/>
          <TextBlock x:Name="AuthError" Foreground="{DynamicResource DangerBrush}" MinHeight="24" Margin="0,4,0,10"/>
          <StackPanel Orientation="Horizontal">
            <Button x:Name="AuthActionButton" Content="Sign in" Style="{StaticResource PrimaryButton}" Click="AuthAction_Click" IsDefault="True"/>
            <Button Content="Retry connection" Click="RetryConnection_Click"/>
          </StackPanel>
          <TextBlock Text="Credentials stay in memory and are never stored by the desktop app." FontSize="12" Foreground="{DynamicResource MutedTextBrush}" Margin="0,20,0,0"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid x:Name="ShellGrid" Visibility="Collapsed">
      <Grid.ColumnDefinitions><ColumnDefinition Width="238"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

      <Border Grid.Column="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,1,0">
        <Grid Margin="18">
          <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
          <StackPanel Margin="4,8,4,26">
            <Border Width="48" Height="7" Background="{DynamicResource AccentBrush}" CornerRadius="4" HorizontalAlignment="Left" Margin="0,0,0,12"/>
            <TextBlock Text="Veltrix-Control" FontSize="20" FontWeight="Bold"/>
            <TextBlock Text="WINDOWS FLEET DESK" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/>
          </StackPanel>
          <StackPanel Grid.Row="1">
            <TextBlock Text="WORKSPACE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="14,0,0,6"/>
            <Button x:Name="DashboardNav" Content="Overview" Tag="DashboardView" Style="{StaticResource NavigationButton}" Click="Navigate_Click"/>
            <Button x:Name="DevicesNav" Content="Devices" Tag="DevicesView" Style="{StaticResource NavigationButton}" Click="Navigate_Click"/>
            <Button x:Name="DiagnosticsNav" Content="Diagnostics" Tag="DiagnosticsView" Style="{StaticResource NavigationButton}" Click="Navigate_Click"/>
            <Button x:Name="FilesNav" Content="Managed files" Tag="FilesView" Style="{StaticResource NavigationButton}" Click="Navigate_Click"/>
            <Button x:Name="AuditNav" Content="Audit history" Tag="AuditView" Style="{StaticResource NavigationButton}" Click="Navigate_Click"/>
            <TextBlock Text="APPLICATION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}" Margin="14,22,0,6"/>
            <Button x:Name="SettingsNav" Content="Settings" Tag="SettingsView" Style="{StaticResource NavigationButton}" Click="Navigate_Click"/>
          </StackPanel>
          <StackPanel Grid.Row="2">
            <Border Background="{DynamicResource SurfaceMutedBrush}" CornerRadius="8" Padding="12" Margin="0,0,0,10">
              <StackPanel>
                <TextBlock x:Name="SignedInName" FontWeight="SemiBold"/>
                <TextBlock x:Name="SignedInRole" FontSize="12" Foreground="{DynamicResource MutedTextBrush}"/>
              </StackPanel>
            </Border>
            <Button Content="Sign out" Style="{StaticResource NavigationButton}" Click="Logout_Click"/>
          </StackPanel>
        </Grid>
      </Border>

      <Grid Grid.Column="1">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Grid.Row="0" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,18">
          <Grid>
            <StackPanel>
              <TextBlock x:Name="ViewEyebrow" Text="FLEET OVERVIEW" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CyanBrush}"/>
              <TextBlock x:Name="ViewTitle" Text="Command center" FontSize="28" FontWeight="SemiBold"/>
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
              <TextBlock x:Name="LastRefreshText" Text="Not synchronized" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="0,0,14,0"/>
              <Button Content="Refresh" Click="Refresh_Click" ToolTip="Refresh (F5)"/>
              <Button x:Name="AddDeviceButton" Content="Add device" Style="{StaticResource PrimaryButton}" Click="AddDevice_Click" ToolTip="Create enrollment code (Ctrl+E)"/>
            </StackPanel>
          </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,24,28,18">
          <Grid x:Name="DashboardView">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Grid.Row="0">
              <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
              <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,12,0"><StackPanel><TextBlock Text="ONLINE" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="OnlineMetric" Text="0" FontSize="34" FontWeight="Bold"/><TextBlock x:Name="OnlineCaption" Text="No devices" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></Border>
              <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="4,0,8,0"><StackPanel><TextBlock Text="AVERAGE CPU" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="CpuMetric" Text="0%" FontSize="34" FontWeight="Bold"/><TextBlock Text="Across online nodes" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></Border>
              <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Margin="8,0,4,0"><StackPanel><TextBlock Text="MEMORY USED" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="MemoryMetric" Text="0 GB" FontSize="34" FontWeight="Bold"/><TextBlock Text="Live total" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></Border>
              <Border Grid.Column="3" Style="{StaticResource PanelBorder}" Margin="12,0,0,0"><StackPanel><TextBlock Text="ATTENTION" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource MutedTextBrush}"/><TextBlock x:Name="AttentionMetric" Text="0" FontSize="34" FontWeight="Bold" Foreground="{DynamicResource WarningBrush}"/><TextBlock Text="Health below 75" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel></Border>
            </Grid>
            <Grid Grid.Row="1" Margin="0,28,0,12">
              <StackPanel><TextBlock Text="LIVE FLEET" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CyanBrush}"/><TextBlock Text="Device health" FontSize="21" FontWeight="SemiBold"/></StackPanel>
              <TextBlock Text="Double-click a device for details and guarded actions." Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right" VerticalAlignment="Bottom"/>
            </Grid>
            <DataGrid x:Name="DashboardDevicesGrid" Grid.Row="2" MouseDoubleClick="DeviceGrid_DoubleClick">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="*"/>
                <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="*"/>
                <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="*"/>
                <DataGridTextColumn Header="Last seen" Binding="{Binding LastSeen}" Width="1.5*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>

          <Grid x:Name="DevicesView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,14">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="190"/></Grid.ColumnDefinitions>
                <TextBox x:Name="DeviceSearchBox" AutomationProperties.Name="Search devices" TextChanged="DeviceFilter_Changed" ToolTip="Search devices (Ctrl+F)"/>
                <ComboBox x:Name="DeviceStatusFilter" Grid.Column="1" Margin="12,0,0,0" SelectionChanged="DeviceFilter_Changed"><ComboBoxItem Content="All devices" IsSelected="True"/><ComboBoxItem Content="Online"/><ComboBoxItem Content="Offline"/><ComboBoxItem Content="Needs attention"/></ComboBox>
              </Grid>
            </Border>
            <DataGrid x:Name="DevicesGrid" Grid.Row="1" MouseDoubleClick="DeviceGrid_DoubleClick">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Device" Binding="{Binding Name}" Width="2*"/>
                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="*"/>
                <DataGridTextColumn Header="Operating system" Binding="{Binding OperatingSystem}" Width="2.5*"/>
                <DataGridTextColumn Header="CPU" Binding="{Binding Cpu}" Width="*"/>
                <DataGridTextColumn Header="Memory" Binding="{Binding Memory}" Width="*"/>
                <DataGridTextColumn Header="Health" Binding="{Binding Health}" Width="*"/>
                <DataGridTextColumn Header="Agent" Binding="{Binding Agent}" Width="*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>

          <Grid x:Name="DiagnosticsView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,14">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="260"/><ColumnDefinition Width="*"/><ColumnDefinition Width="230"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="DiagnosticsDeviceBox" DisplayMemberPath="Name" AutomationProperties.Name="Diagnostics device"/>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="14,0,0,0">
                  <Button Content="Processes" Tag="ListProcesses" Click="Diagnostic_Click"/>
                  <Button Content="Services" Tag="ListServices" Click="Diagnostic_Click"/>
                  <Button Content="Software" Tag="ListSoftware" Click="Diagnostic_Click"/>
                  <Button Content="Network" Tag="ListNetworkAdapters" Click="Diagnostic_Click"/>
                </StackPanel>
                <TextBox x:Name="DiagnosticSearchBox" Grid.Column="2" AutomationProperties.Name="Filter diagnostic results" TextChanged="DiagnosticSearch_Changed" ToolTip="Filter current results"/>
              </Grid>
            </Border>
            <TextBlock x:Name="DiagnosticCaption" Grid.Row="1" Text="Choose an online device and a read-only diagnostic." Foreground="{DynamicResource MutedTextBrush}" Margin="2,0,0,12"/>
            <DataGrid x:Name="DiagnosticsGrid" Grid.Row="2" AutoGenerateColumns="True"/>
          </Grid>

          <Grid x:Name="FilesView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="240"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                <ComboBox x:Name="FilesDeviceBox" DisplayMemberPath="Name" AutomationProperties.Name="File browser device" SelectionChanged="FilesDevice_Changed"/>
                <Button Grid.Column="1" Content="Up" Margin="12,0,8,0" Click="FilesUp_Click"/>
                <Button Grid.Column="2" Content="Refresh" Click="FilesRefresh_Click"/>
                <TextBox x:Name="CurrentPathBox" Grid.Column="3" Margin="12,0,12,0" IsReadOnly="True" AutomationProperties.Name="Current managed path"/>
                <TextBox x:Name="FilesSearchBox" Grid.Column="4" AutomationProperties.Name="Filter files" TextChanged="FilesSearch_Changed" ToolTip="Filter the current folder"/>
              </Grid>
            </Border>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,10">
              <WrapPanel>
                <Button Content="New folder" Margin="0,0,8,0" Click="FilesNewFolder_Click"/>
                <Button Content="New file" Margin="0,0,8,0" Click="FilesNewFile_Click"/>
                <Button Content="Rename" Margin="0,0,8,0" Click="FilesRename_Click"/>
                <Button Content="Copy to…" Margin="0,0,8,0" Click="FilesCopy_Click"/>
                <Button Content="Move to…" Margin="0,0,8,0" Click="FilesMove_Click"/>
                <Button Content="Delete" Margin="0,0,8,0" Click="FilesDelete_Click"/>
                <Button Content="Upload" Margin="0,0,8,0" Click="FilesUpload_Click"/>
                <Button Content="Download" Margin="0,0,8,0" Click="FilesDownload_Click"/>
                <Button Content="Edit" Margin="0,0,8,0" Click="FilesEdit_Click"/>
                <Button Content="History" Margin="0,0,8,0" Click="FilesHistory_Click"/>
                <Button Content="Folder size" Margin="0,0,8,0" Click="FilesSize_Click"/>
                <Button Content="Zip" Margin="0,0,8,0" Click="FilesZip_Click"/>
                <Button Content="Extract" Click="FilesExtract_Click"/>
              </WrapPanel>
            </Border>
            <TextBlock Grid.Row="2" Text="Paths are re-validated on the managed node. Double-click a folder to open it or a text file to edit it." Foreground="{DynamicResource MutedTextBrush}" Margin="2,0,0,10"/>
            <DataGrid x:Name="FilesGrid" Grid.Row="3" MouseDoubleClick="FilesGrid_DoubleClick">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Name" Binding="{Binding Name}" Width="3*"/>
                <DataGridTextColumn Header="Type" Binding="{Binding Kind}" Width="*"/>
                <DataGridTextColumn Header="Size" Binding="{Binding Size}" Width="*"/>
                <DataGridTextColumn Header="Modified" Binding="{Binding Modified}" Width="1.5*"/>
              </DataGrid.Columns>
            </DataGrid>
            <Border Grid.Row="4" Style="{StaticResource PanelBorder}" Margin="0,10,0,0">
              <Grid>
                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                <Grid>
                  <StackPanel Orientation="Horizontal">
                    <TextBlock Text="TRANSFERS" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CyanBrush}" VerticalAlignment="Center"/>
                    <TextBlock x:Name="TransferCaption" Text="No recent transfers" Foreground="{DynamicResource MutedTextBrush}" Margin="12,0,0,0" VerticalAlignment="Center"/>
                  </StackPanel>
                  <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Reload" Click="FilesReloadTransfers_Click"/>
                    <Button Content="Cancel" Margin="8,0,0,0" Click="FilesCancelTransfer_Click"/>
                  </StackPanel>
                </Grid>
                <DataGrid x:Name="TransfersGrid" Grid.Row="1" MinHeight="120" MaxHeight="200" Margin="0,10,0,0">
                  <DataGrid.Columns>
                    <DataGridTextColumn Header="Path" Binding="{Binding Name}" Width="3*"/>
                    <DataGridTextColumn Header="Direction" Binding="{Binding Direction}" Width="*"/>
                    <DataGridTemplateColumn Header="Progress" Width="2*">
                      <DataGridTemplateColumn.CellTemplate>
                        <DataTemplate>
                          <ProgressBar Height="14" Minimum="0" Maximum="100" Value="{Binding Progress, Mode=OneWay}" VerticalAlignment="Center"/>
                        </DataTemplate>
                      </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                    <DataGridTextColumn Header="Transferred" Binding="{Binding Transferred}" Width="1.5*"/>
                    <DataGridTextColumn Header="State" Binding="{Binding State}" Width="*"/>
                    <DataGridTextColumn Header="Detail" Binding="{Binding Detail}" Width="2*"/>
                  </DataGrid.Columns>
                </DataGrid>
              </Grid>
            </Border>
          </Grid>

          <Grid x:Name="AuditView" Visibility="Collapsed">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,14">
              <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="240"/></Grid.ColumnDefinitions>
                <Button Content="Reload" Click="LoadAudit_Click"/>
                <Button x:Name="VerifyAuditButton" Grid.Column="1" Content="Verify chain" Click="VerifyAudit_Click"/>
                <Button Grid.Column="2" Content="Export CSV" Click="ExportAudit_Click"/>
                <TextBlock x:Name="AuditIntegrityText" Grid.Column="3" Text="Not verified" Foreground="{DynamicResource MutedTextBrush}" VerticalAlignment="Center" Margin="12,0"/>
                <TextBox x:Name="AuditSearchBox" Grid.Column="4" AutomationProperties.Name="Filter audit events" TextChanged="AuditSearch_Changed"/>
              </Grid>
            </Border>
            <DataGrid x:Name="AuditGrid" Grid.Row="1">
              <DataGrid.Columns>
                <DataGridTextColumn Header="Time" Binding="{Binding Time}" Width="1.5*"/>
                <DataGridTextColumn Header="Actor" Binding="{Binding Actor}" Width="*"/>
                <DataGridTextColumn Header="Action" Binding="{Binding Action}" Width="1.5*"/>
                <DataGridTextColumn Header="Target" Binding="{Binding Target}" Width="1.5*"/>
                <DataGridTextColumn Header="Outcome" Binding="{Binding Outcome}" Width="*"/>
                <DataGridTextColumn Header="Details" Binding="{Binding Details}" Width="2*"/>
              </DataGrid.Columns>
            </DataGrid>
          </Grid>

          <ScrollViewer x:Name="SettingsView" Visibility="Collapsed" VerticalScrollBarVisibility="Auto">
            <StackPanel MaxWidth="760" HorizontalAlignment="Left">
              <Border Style="{StaticResource PanelBorder}" Margin="0,0,0,16">
                <StackPanel>
                  <TextBlock Text="Controller connection" FontSize="21" FontWeight="SemiBold"/>
                  <TextBlock Text="Remote addresses must use HTTPS. Local loopback may use HTTP." Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,18"/>
                  <Label Content="Controller address" Target="{Binding ElementName=SettingsControllerUrl}"/>
                  <TextBox x:Name="SettingsControllerUrl" Margin="0,0,0,14"/>
                  <Label Content="Refresh interval" Target="{Binding ElementName=RefreshIntervalBox}"/>
                  <ComboBox x:Name="RefreshIntervalBox" HorizontalAlignment="Left" Width="180"><ComboBoxItem Content="5 seconds" Tag="5"/><ComboBoxItem Content="10 seconds" Tag="10"/><ComboBoxItem Content="30 seconds" Tag="30"/><ComboBoxItem Content="60 seconds" Tag="60"/></ComboBox>
                  <CheckBox x:Name="AutoRefreshCheck" Content="Refresh fleet automatically" Margin="0,12,0,16"/>
                  <Button Content="Save and reconnect" Style="{StaticResource PrimaryButton}" HorizontalAlignment="Left" Click="SaveSettings_Click"/>
                </StackPanel>
              </Border>
              <Border Style="{StaticResource PanelBorder}">
                <StackPanel>
                  <TextBlock Text="Controller identity" FontSize="21" FontWeight="SemiBold"/>
                  <TextBlock Text="Verify this SHA-256 fingerprint out of band before enrolling a remote node." Foreground="{DynamicResource MutedTextBrush}" Margin="0,4,0,14"/>
                  <TextBox x:Name="CertificateFingerprintBox" IsReadOnly="True" Text="Load after sign-in"/>
                  <Button Content="Copy fingerprint" HorizontalAlignment="Left" Margin="0,12,0,0" Click="CopyFingerprint_Click"/>
                </StackPanel>
              </Border>
            </StackPanel>
          </ScrollViewer>
        </Grid>

        <Border Grid.Row="2" BorderBrush="{DynamicResource BorderBrush}" BorderThickness="0,1,0,0" Padding="28,10">
          <Grid>
            <StackPanel Orientation="Horizontal"><Ellipse x:Name="ConnectionDot" Width="9" Height="9" Fill="{DynamicResource WarningBrush}" Margin="0,0,8,0"/><TextBlock x:Name="StatusText" Text="Connecting…" Foreground="{DynamicResource MutedTextBrush}"/></StackPanel>
            <TextBlock Text="F5 Refresh   Ctrl+F Search   Ctrl+E Enroll   Ctrl+, Settings" FontSize="12" Foreground="{DynamicResource MutedTextBrush}" HorizontalAlignment="Right"/>
          </Grid>
        </Border>
      </Grid>
    </Grid>
  </Grid>
</Window>
