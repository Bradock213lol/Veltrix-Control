<Window x:Class="VeltrixControl.Desktop.GameServerWindow" Style="{StaticResource {x:Type Window}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New game server" Width="600" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20">
    <TextBlock Text="Create a game server" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock x:Name="Subtitle" Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,16"/>
    <Label Content="Server name"/>
    <TextBox x:Name="NameBox" MaxLength="128" Margin="0,0,0,12"/>
    <Label Content="Adapter"/>
    <ComboBox x:Name="AdapterBox" HorizontalAlignment="Left" Width="220" Margin="0,0,0,12">
      <ComboBoxItem Content="MinecraftJava" IsSelected="True"/>
    </ComboBox>
    <Label Content="Install folder (relative to managed root)"/>
    <TextBox x:Name="InstallPathBox" MaxLength="1024" Margin="0,0,0,12"/>
    <Grid>
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <StackPanel><Label Content="Port"/><TextBox x:Name="PortBox" Text="25565"/></StackPanel>
      <StackPanel Grid.Column="1" Margin="10,0,0,0"><Label Content="Memory (MB)"/><TextBox x:Name="MemoryBox" Text="2048"/></StackPanel>
      <StackPanel Grid.Column="2" Margin="10,0,0,0"><Label Content="CPU threads"/><TextBox x:Name="CpuBox" Text="2"/></StackPanel>
      <StackPanel Grid.Column="3" Margin="10,0,0,0"><Label Content="Version (optional)"/><TextBox x:Name="VersionBox"/></StackPanel>
    </Grid>
    <CheckBox x:Name="AutoRestartCheck" Content="Restart automatically after a crash" IsChecked="True" Margin="0,12,0,4"/>
    <TextBlock Text="Provisioning downloads the official server jar and verifies its published checksum. Java 21+ is required for Minecraft Java." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,0,0,12"/>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" MinHeight="22" Margin="0,0,0,8"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/>
      <Button Content="Create and provision" Style="{StaticResource PrimaryButton}" Click="Create_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
