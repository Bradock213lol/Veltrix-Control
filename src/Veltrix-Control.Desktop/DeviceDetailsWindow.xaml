<Window x:Class="VeltrixControl.Desktop.DeviceDetailsWindow" Style="{StaticResource {x:Type Window}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Device details — Veltrix-Control" Width="860" Height="680" MinWidth="720" MinHeight="560"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="28">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

    <Grid>
      <StackPanel>
        <TextBlock Style="{StaticResource EyebrowText}" Text="DEVICE PROFILE"/>
        <TextBlock x:Name="DeviceNameText" Style="{StaticResource PageTitleText}" Margin="0,6,0,4"/>
        <TextBlock x:Name="DeviceIdentityText" Style="{StaticResource SubtleText}"/>
      </StackPanel>
      <Border x:Name="StatusBadge" HorizontalAlignment="Right" VerticalAlignment="Top" CornerRadius="14" Padding="14,7" Background="{DynamicResource AccentSoftBrush}">
        <StackPanel Orientation="Horizontal">
          <Ellipse x:Name="StatusDot" Width="8" Height="8" VerticalAlignment="Center" Margin="0,0,8,0" Fill="{DynamicResource SuccessBrush}"/>
          <TextBlock x:Name="StatusText" FontWeight="SemiBold"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="1" Margin="0,24,0,22">
      <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource PanelBorder}" Margin="0,0,8,0">
        <StackPanel>
          <TextBlock Style="{StaticResource MetricLabelText}" Text="HEALTH"/>
          <TextBlock x:Name="HealthText" Style="{StaticResource MetricValueText}" Margin="0,6,0,2"/>
          <TextBlock x:Name="HealthCaption" Style="{StaticResource CaptionText}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="4,0">
        <StackPanel>
          <TextBlock Style="{StaticResource MetricLabelText}" Text="CPU"/>
          <TextBlock x:Name="CpuText" Style="{StaticResource MetricValueText}" Margin="0,6,0,2"/>
          <TextBlock x:Name="CpuCaption" Style="{StaticResource CaptionText}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="2" Style="{StaticResource PanelBorder}" Margin="4,0">
        <StackPanel>
          <TextBlock Style="{StaticResource MetricLabelText}" Text="MEMORY USED / TOTAL"/>
          <TextBlock x:Name="MemoryText" Style="{StaticResource MetricValueText}" Margin="0,6,0,2"/>
          <TextBlock x:Name="MemoryCaption" Style="{StaticResource CaptionText}"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="3" Style="{StaticResource PanelBorder}" Margin="8,0,0,0">
        <StackPanel>
          <TextBlock Style="{StaticResource MetricLabelText}" Text="UPTIME"/>
          <TextBlock x:Name="UptimeText" Style="{StaticResource MetricValueText}" Margin="0,6,0,2"/>
          <TextBlock x:Name="UptimeCaption" Style="{StaticResource CaptionText}" Text="since last boot"/>
        </StackPanel>
      </Border>
    </Grid>

    <Grid Grid.Row="2">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="1.5*"/></Grid.ColumnDefinitions>
      <Border Style="{StaticResource PanelBorder}" Margin="0,0,10,0">
        <StackPanel>
          <TextBlock Text="System" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
          <TextBlock Style="{StaticResource SubtleText}" Text="Operating system"/>
          <TextBlock x:Name="OsText" Margin="0,3,0,12"/>
          <TextBlock Style="{StaticResource SubtleText}" Text="Architecture and processors"/>
          <TextBlock x:Name="HardwareText" Margin="0,3,0,12"/>
          <TextBlock Style="{StaticResource SubtleText}" Text="Agent"/>
          <TextBlock x:Name="AgentText" Margin="0,3,0,12"/>
          <TextBlock Style="{StaticResource SubtleText}" Text="Last heartbeat"/>
          <TextBlock x:Name="HeartbeatText" Margin="0,3,0,16"/>
          <Button Content="Copy device ID" HorizontalAlignment="Left" Click="CopyId_Click"/>
        </StackPanel>
      </Border>
      <Border Grid.Column="1" Style="{StaticResource PanelBorder}" Margin="10,0,0,0">
        <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
          <TextBlock Text="Storage" FontSize="18" FontWeight="SemiBold" Margin="0,0,0,14"/>
          <DataGrid x:Name="DiskGrid" Grid.Row="1">
            <DataGrid.Columns>
              <DataGridTextColumn Header="Drive" Binding="{Binding Name}" Width="*"/>
              <DataGridTextColumn Header="Format" Binding="{Binding Format}" Width="*"/>
              <DataGridTextColumn Header="Used / total" Binding="{Binding UsedTotal}" Width="1.4*"/>
              <DataGridTextColumn Header="Free" Binding="{Binding Free}" Width="*"/>
              <DataGridTextColumn Header="Used %" Binding="{Binding UsedPercent}" Width="*"/>
            </DataGrid.Columns>
          </DataGrid>
        </Grid>
      </Border>
    </Grid>

    <Grid Grid.Row="3" Margin="0,22,0,0">
      <TextBlock x:Name="ActionStatusText" Style="{StaticResource CaptionText}" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="RestartButton" Content="Restart…" Click="Restart_Click"/>
        <Button x:Name="ShutdownButton" Content="Shut down…" Style="{StaticResource DangerButton}" Click="Shutdown_Click"/>
        <Button Content="Close" IsCancel="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
