<Window x:Class="VeltrixControl.Desktop.EnrollmentWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Add device · Veltrix-Control" Width="590" Height="430" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
  <Grid Margin="30">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel>
      <TextBlock Text="SECURE ENROLLMENT" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource CyanBrush}"/>
      <TextBlock Text="Add a managed device" FontSize="27" FontWeight="SemiBold"/>
      <TextBlock Text="Codes are single-use and can be revoked immediately." Foreground="{DynamicResource MutedTextBrush}" Margin="0,5,0,0"/>
    </StackPanel>
    <StackPanel Grid.Row="1" Margin="0,22,0,16">
      <Label Content="Code lifetime" Target="{Binding ElementName=LifetimeBox}"/>
      <ComboBox x:Name="LifetimeBox" Width="190" HorizontalAlignment="Left">
        <ComboBoxItem Content="5 minutes" Tag="5"/><ComboBoxItem Content="15 minutes" Tag="15" IsSelected="True"/>
        <ComboBoxItem Content="30 minutes" Tag="30"/><ComboBoxItem Content="60 minutes" Tag="60"/>
      </ComboBox>
    </StackPanel>
    <Border Grid.Row="2" Style="{StaticResource PanelBorder}">
      <StackPanel>
        <TextBlock Text="ENROLLMENT CODE" FontSize="10" Foreground="{DynamicResource MutedTextBrush}"/>
        <TextBox x:Name="CodeBox" IsReadOnly="True" FontFamily="Consolas" FontSize="19" Text="Create a code when you are ready" Margin="0,8,0,10"/>
        <TextBlock x:Name="ExpiryText" Foreground="{DynamicResource MutedTextBrush}"/>
        <TextBlock Text="Use this code in the Veltrix-Control installer on the managed device. Verify the Controller certificate fingerprint separately." TextWrapping="Wrap" Margin="0,14,0,0"/>
      </StackPanel>
    </Border>
    <Grid Grid.Row="3" Margin="0,20,0,0">
      <TextBlock x:Name="StatusText" Foreground="{DynamicResource DangerBrush}" VerticalAlignment="Center"/>
      <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
        <Button x:Name="CreateButton" Content="Create code" Style="{StaticResource PrimaryButton}" Click="Create_Click"/>
        <Button x:Name="CopyButton" Content="Copy" Click="Copy_Click" IsEnabled="False"/>
        <Button x:Name="RevokeButton" Content="Revoke" Click="Revoke_Click" IsEnabled="False"/>
        <Button Content="Close" IsCancel="True"/>
      </StackPanel>
    </Grid>
  </Grid>
</Window>
