<Window x:Class="VeltrixControl.Desktop.IntegrationWindow" Style="{StaticResource {x:Type Window}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="New integration" Width="560" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner">
  <StackPanel Margin="20">
    <TextBlock Text="Connect an external environment" FontSize="20" FontWeight="SemiBold"/>
    <TextBlock Text="Integrations are optional and never become dependencies of core management workflows. Credentials are encrypted at rest with a Controller-local key." Foreground="{DynamicResource MutedTextBrush}" TextWrapping="Wrap" Margin="0,4,0,16"/>
    <Label Content="Kind"/>
    <ComboBox x:Name="KindBox" HorizontalAlignment="Left" Width="220" SelectionChanged="Kind_Changed">
      <ComboBoxItem Content="Docker" IsSelected="True"/>
      <ComboBoxItem Content="Pterodactyl"/>
    </ComboBox>
    <Label Content="Display name"/>
    <TextBox x:Name="NameBox" MaxLength="128" Margin="0,0,0,12"/>
    <Label x:Name="EndpointLabel" Content="Docker endpoint (npipe:// or https://)"/>
    <TextBox x:Name="EndpointBox" MaxLength="512" Margin="0,0,0,12"/>
    <Label Content="API key / credential (optional)"/>
    <PasswordBox x:Name="CredentialBox" MaxLength="4096" Margin="0,0,0,16"/>
    <TextBlock x:Name="ErrorText" Foreground="{DynamicResource DangerBrush}" MinHeight="22" Margin="0,0,0,8"/>
    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
      <Button Content="Cancel" IsCancel="True" Margin="0,0,10,0"/>
      <Button Content="Add integration" Style="{StaticResource PrimaryButton}" Click="Create_Click"/>
    </StackPanel>
  </StackPanel>
</Window>
