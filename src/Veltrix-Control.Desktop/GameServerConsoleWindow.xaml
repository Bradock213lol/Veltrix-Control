<Window x:Class="VeltrixControl.Desktop.GameServerConsoleWindow" Style="{StaticResource {x:Type Window}}"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Game server console" Width="900" Height="620" MinWidth="640" MinHeight="420"
        WindowStartupLocation="CenterOwner">
  <Grid Margin="16">
    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
    <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
      <TextBlock x:Name="StatusText" FontWeight="SemiBold" VerticalAlignment="Center"/>
      <Button x:Name="RefreshButton" Content="Refresh output" Margin="16,0,0,0" Click="Refresh_Click"/>
    </StackPanel>
    <TextBox x:Name="OutputBox" Grid.Row="1" IsReadOnly="True" FontFamily="Consolas" FontSize="12.5"
             AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto" TextWrapping="NoWrap"/>
    <Grid Grid.Row="2" Margin="0,10,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
      <TextBox x:Name="InputBox" FontFamily="Consolas" AutomationProperties.Name="Server command" KeyDown="Input_KeyDown"/>
      <Button Grid.Column="1" Content="Send" Margin="8,0,0,0" Click="Send_Click"/>
    </Grid>
  </Grid>
</Window>
